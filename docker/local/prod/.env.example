############################################################
# Variables utilizadas en docker-compose.yaml
############################################################
DOCKER_API_PORT=8080
DOCKER_HOST_PORT=8040
DOCKER_FIRESTORE_EMULATOR_PORT=8200
DOCKER_FIRESTORE_EMULATOR_HOST_PORT=8200
API_PORT=8020
DOCKER_LIMITS_CPUS='1'
DOCKER_LIMITS_MEMORY='512M'
DOCKER_PIP_VERSION="pip --version"

############################################################
# Variables de ambiente de la aplicación
# ENVIRONMENT: Indica el ambiente en el que se encuentra trabajando
# la aplicación. Puede ser: development, staging, production.
# FLASK_ENV: Indica el ambiente de Flask. Puede ser: development y production.
# Si se indica development, entonces se activa el modo debug de Flask
# PROJECT_ID: Name of the GCP target project. Used for
# deployment and link logs explorer
############################################################
ENVIRONMENT=development
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=127.0.0.1
PROJECT_ID=zitio
SERVICE_NAME=zitio

############################################################
# Variables de control de logs
# LOG_LEVEL: Nivel de logs. Puede ser: DEBUG, INFO, WARNING, ERROR y CRITICAL
# SHOW_TRACEBACK: Si es True, entonces se muestran el
# traceback de la excepcion. Solo para el nivel INFO
############################################################
LOG_LEVEL=DEBUG
SHOW_TRACEBACK=True

############################################################
# Variables de Firestore
# FIRESTORE_EMULATOR_HOST: host:port del emulador. Si está definida, la app
# usa el emulador y no necesita credenciales. docker compose ya la define
# para el contenedor; descomentarla solo al correr la app fuera de Docker.
############################################################
# FIRESTORE_EMULATOR_HOST=localhost:8200
